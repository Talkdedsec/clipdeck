<Window x:Class="ClipDeck.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ClipDeck.Core"
        xmlns:ui="clr-namespace:ClipDeck.UI"
        Title="clipdeck" Width="400" Height="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ItemContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_LeftClick"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="Item_RightClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource Card}" BorderBrush="Transparent"
                                BorderThickness="1.5" CornerRadius="7" Padding="11,9" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasTitle, Converter={StaticResource BoolVis}}"/>
                <DockPanel Grid.Row="1" Visibility="{Binding ShowPlain, Converter={StaticResource BoolVis}}">
                    <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Top"
                            Background="{Binding ColorSwatch}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Visibility="{Binding HasColor, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="57" LineHeight="19" LineStackingStrategy="BlockLineHeight"/>
                </DockPanel>
                <TextBlock Grid.Row="1" ui:CodeText.Source="{Binding Preview}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="68" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ShowCode, Converter={StaticResource BoolVis}}"/>
                <Border Grid.Row="2" CornerRadius="4" HorizontalAlignment="Left" ClipToBounds="True"
                        Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}">
                    <Image Source="{Binding Thumbnail}" MaxHeight="110" MaxWidth="340" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.RowSpan="4" Margin="10,1,0,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Right" ToolTip="{ui:T Sabitli}"
                               Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding QuickIndex}" FontSize="10" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"
                               Margin="0,3,0,0" ToolTip="{ui:T 'Ctrl + rakam ile hızlı yapıştır'}"
                               Visibility="{Binding ShowQuickIndex, Converter={StaticResource BoolVis}}"/>
                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Accent}" HorizontalAlignment="Right"
                            Margin="0,3,0,0" Visibility="{Binding IsChecked, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickCell" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Card}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type core:PickHeaderRow}">
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" Margin="4,6,0,4"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:PickLineRow}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PickCell}" Width="{Binding CellWidth}" Height="{Binding CellHeight}"
                                ToolTip="{Binding Name}" Click="Cell_Click">
                            <Grid>
                                <Image Source="{Binding Image}" Width="26" Height="26"
                                       Visibility="{Binding ShowImage, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontFamily="Segoe UI, Segoe UI Symbol, Segoe UI Emoji"
                                           TextTrimming="CharacterEllipsis" Margin="4,0"
                                           Visibility="{Binding ShowText, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="7,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Rectangle x:Name="Bar" Height="3" Width="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Card}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Image x:Name="BgImage" Stretch="Fill" Visibility="Collapsed"/>
        <Rectangle x:Name="BgDim" Fill="{DynamicResource Bg}" Visibility="Collapsed"/>

        <Grid Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SkinToneButton" Style="{StaticResource IconButton}" ToolTip="{ui:T 'Ten rengi'}"
                            Click="SkinTone_Click" Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="SkinToneImage" Width="20" Height="20"/>
                            <TextBlock x:Name="SkinToneText" Text="✋" FontSize="15" FontFamily="Segoe UI Emoji" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="{ui:T 'Kaydı duraklat'}" Click="Pause_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{ui:T Ayarlar}" Click="Settings_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SecClipboard" Style="{StaticResource TabButton}" GroupName="PopupSections" IsChecked="True"
                                 ToolTip="{ui:T 'Pano geçmişi'}" Checked="Section_Checked">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </RadioButton>
                    <RadioButton x:Name="SecEmoji" Style="{StaticResource TabButton}" GroupName="PopupSections"
                                 ToolTip="{ui:T Emoji}" Checked="Section_Checked">
                        <TextBlock Text="&#xE76E;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </RadioButton>
                    <RadioButton x:Name="SecKaomoji" Style="{StaticResource TabButton}" GroupName="PopupSections"
                                 ToolTip="{ui:T Kaomoji}" Checked="Section_Checked">
                        <TextBlock Text=";-)" FontSize="13" FontWeight="SemiBold" Margin="0,-1,0,0"/>
                    </RadioButton>
                    <RadioButton x:Name="SecSymbols" Style="{StaticResource TabButton}" GroupName="PopupSections"
                                 ToolTip="{ui:T Semboller}" Checked="Section_Checked">
                        <TextBlock Text="Ω" FontSize="15" Margin="0,-2,0,0"/>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Margin="0,8,0,8" Height="36" CornerRadius="6"
                    Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextDim}"
                               VerticalAlignment="Center" Margin="11,0,0,0"/>
                    <TextBlock x:Name="SearchHint" Foreground="{DynamicResource TextDim}"
                               VerticalAlignment="Center" Margin="35,0,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="SearchBox" Margin="31,0,8,0" Padding="0" Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center" TextChanged="Search_TextChanged"
                             ContextMenuService.IsEnabled="False"/>
                </Grid>
            </Border>

            <DockPanel x:Name="ClipBar" Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
                <RadioButton x:Name="TabHistory" Style="{StaticResource TabButton}" Content="{ui:T Geçmiş}" GroupName="PopupClipTabs" IsChecked="True" Checked="ClipTab_Checked"/>
                <RadioButton x:Name="TabPinned" Style="{StaticResource TabButton}" Content="{ui:T Sabitli}" GroupName="PopupClipTabs" Checked="ClipTab_Checked"/>
                <RadioButton x:Name="TabSnippets" Style="{StaticResource TabButton}" Content="{ui:T Snippet}" GroupName="PopupClipTabs" Checked="ClipTab_Checked"/>
                <Button x:Name="NewSnippetButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                        ToolTip="{ui:T 'Yeni snippet'}" Visibility="Collapsed" Click="NewSnippet_Click"/>
                <Button x:Name="FilterButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE71C;"
                        ToolTip="{ui:T Filtrele}" Click="Filter_Click"/>
                <TextBlock x:Name="FilterLabel" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center" Margin="0,0,4,0" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <ListBox x:Name="List" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                     ItemContainerStyle="{StaticResource ItemContainer}" ItemTemplate="{StaticResource ItemTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"/>

            <ListBox x:Name="PickList" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                     ItemContainerStyle="{StaticResource RowContainer}" Visibility="Collapsed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item" ScrollViewer.ScrollChanged="PickList_ScrollChanged"/>

            <TextBlock x:Name="EmptyText" Grid.Row="3" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="21" Margin="20,0" Visibility="Collapsed"/>

            <ScrollViewer x:Name="CategoryScroll" Grid.Row="4" Margin="0,6,0,0" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="CategoryScroll_Wheel" Visibility="Collapsed">
                <ItemsControl x:Name="CategoryBar">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CategoryButton}" ToolTip="{Binding Name}" Click="Category_Click">
                                <Grid>
                                    <Image Source="{Binding IconImage}" Width="20" Height="20"
                                           Visibility="{Binding ShowIconImage, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Visibility="{Binding ShowGlyph, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Icon}" FontSize="13"
                                               Visibility="{Binding ShowIconText, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="Status" Grid.Row="5" Margin="2,4,0,0" FontSize="11" Foreground="{DynamicResource TextDim}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>
