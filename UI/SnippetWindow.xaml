<Window x:Class="ClipDeck.UI.SnippetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClipDeck.UI"
        Title="Snippet" Width="540" Height="470" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        Icon="/Assets/clipdeck.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{ui:T Başlık}" Foreground="{DynamicResource TextDim}" Margin="0,0,0,5"/>
        <TextBox x:Name="TitleBox" Grid.Row="1"/>
        <TextBlock Grid.Row="2" Text="{ui:T İçerik}" Foreground="{DynamicResource TextDim}" Margin="0,12,0,5"/>
        <TextBox x:Name="ContentBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
        <TextBlock x:Name="VarsHint" Grid.Row="4" Foreground="{DynamicResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="Error" DockPanel.Dock="Left" Foreground="{DynamicResource Danger}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{ui:T Kaydet}" Click="Save_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{ui:T İptal}" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
