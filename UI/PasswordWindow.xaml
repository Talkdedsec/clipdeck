<Window x:Class="ClipDeck.UI.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClipDeck.UI"
        Title="clipdeck" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/clipdeck.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="Info" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="{ui:T Parola}" Margin="0,0,0,5"/>
        <PasswordBox x:Name="Pass1"/>
        <TextBlock x:Name="ConfirmLabel" Text="{ui:T 'Parola (tekrar)'}" Margin="0,10,0,5"/>
        <PasswordBox x:Name="Pass2"/>
        <TextBlock x:Name="Error" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{ui:T Tamam}" IsDefault="True" Margin="8,0,0,0" Click="Ok_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{ui:T İptal}" IsCancel="True"/>
        </DockPanel>
    </StackPanel>
</Window>
