<Window x:Class="ClipDeck.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClipDeck.UI"
        Title="clipdeck" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="/Assets/clipdeck.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="26,22,26,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/clipdeck.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{ui:T 'Pano geçmişi, emoji, kaomoji ve semboller'}" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border x:Name="InstallPanel" Background="{DynamicResource Surface}" CornerRadius="8" Padding="16,12" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock x:Name="InstallPath" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <CheckBox x:Name="OptStartMenu" IsChecked="True" Content="{ui:T 'Başlat menüsüne kısayol ekle'}"/>
                <CheckBox x:Name="OptDesktop" Content="{ui:T 'Masaüstüne kısayol ekle'}"/>
                <CheckBox x:Name="OptAutostart" IsChecked="True" Content="{ui:T 'Windows açılınca başlat'}"/>
                <CheckBox x:Name="OptLaunch" IsChecked="True" Content="{ui:T 'Kurulumdan sonra başlat'}"/>
                <TextBlock Foreground="{DynamicResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="{ui:T 'Yönetici izni gerekmez; yalnızca bu Windows kullanıcısı için kurulur. Geçmişin ve ayarların korunur.'}"/>
            </StackPanel>
        </Border>

        <Border x:Name="UninstallPanel" Background="{DynamicResource Surface}" CornerRadius="8" Padding="16,12" Margin="0,18,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" LineHeight="21"
                           Text="{ui:T 'clipdeck bu bilgisayardan kaldırılacak: program dosyaları, kısayollar ve otomatik başlatma silinir.'}"/>
                <CheckBox x:Name="OptRemoveData" Margin="0,10,0,0" Content="{ui:T 'Geçmişi, snippet\'leri ve ayarları da sil'}"/>
            </StackPanel>
        </Border>

        <Border x:Name="DonePanel" Background="{DynamicResource Surface}" CornerRadius="8" Padding="16,12" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock x:Name="DoneText" TextWrapping="Wrap" LineHeight="21"/>
        </Border>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="UninstallButton" DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Content="{ui:T Kaldır}"
                    Visibility="Collapsed" Click="Uninstall_Click"/>
            <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="Primary_Click"/>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{ui:T İptal}" IsCancel="True"/>
        </DockPanel>
    </StackPanel>
</Window>
