<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>clipdeck</AssemblyName>
    <RootNamespace>ClipDeck</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clipdeck.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Product>clipdeck</Product>
    <Description>clipdeck - pano gecmisi</Description>
    <Copyright>Copyright (c) 2026 Talkdedsec</Copyright>
    <RepositoryUrl>https://github.com/Talkdedsec/clipdeck</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <InternalsVisibleTo Include="clipdeck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\clipdeck.ico" />
    <Resource Include="Assets\clipdeck.png" />
    <Resource Include="Assets\emoji.tsv" />
    <Resource Include="Assets\kaomoji.txt" />
    <Resource Include="Assets\semboller.txt" />
  </ItemGroup>

</Project>
